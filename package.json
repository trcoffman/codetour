{
  "name": "codetour-plus",
  "displayName": "CodeTour+",
  "description": "Record and play back guided tours of your codebase in VS Code. A maintained fork of Microsoft's CodeTour that reads and writes the same .tour files. Also ships the codetour CLI.",
  "publisher": "TylerCoffman",
  "version": "0.0.62",
  "author": {
    "name": "Tyler Coffman"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trcoffman/codetour"
  },
  "bugs": {
    "url": "https://github.com/trcoffman/codetour/issues"
  },
  "homepage": "https://github.com/trcoffman/codetour#readme",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codetour",
    "code tour",
    "walkthrough",
    "onboarding",
    "Collaboration",
    "Sharing"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onNotebookEditor:codetourPlus"
  ],
  "main": "./dist/extension-node.js",
  "bin": {
    "codetour": "dist/cli.js"
  },
  "browser": "./dist/extension-web.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "CodeTour+",
      "properties": {
        "codetourPlus.promptForWorkspaceTours": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether or not to display a notification when opening a workspace with tours for the first time."
        },
        "codetourPlus.recordMode": {
          "type": "string",
          "enum": [
            "lineNumber",
            "pattern"
          ],
          "default": "lineNumber",
          "description": "Specifies how the tour recorder will behave when capturing a new step."
        },
        "codetourPlus.showMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether or not to show tour markers in the editor gutter."
        },
        "codetourPlus.customTourDirectory": {
          "type": "string",
          "default": null,
          "description": "Specifies a custom location to use when discovering tours."
        }
      }
    },
    "commands": [
      {
        "command": "codetourPlus.addContentStep",
        "title": "Add Tour Step",
        "category": "CodeTour+"
      },
      {
        "command": "codetourPlus.addDirectoryStep",
        "title": "Add CodeTour+ Step"
      },
      {
        "command": "codetourPlus.addSelectionStep",
        "title": "Add CodeTour+ Step"
      },
      {
        "command": "codetourPlus.addTourStep",
        "title": "Add Step to Tour"
      },
      {
        "command": "codetourPlus.changeTourDescription",
        "title": "Change Description"
      },
      {
        "command": "codetourPlus.changeTourRef",
        "title": "Change Git Ref"
      },
      {
        "command": "codetourPlus.changeTourStepLine",
        "title": "Change Line"
      },
      {
        "command": "codetourPlus.changeTourStepTitle",
        "title": "Change Title"
      },
      {
        "command": "codetourPlus.changeTourStepIcon",
        "title": "Change Icon"
      },
      {
        "command": "codetourPlus.changeTourTitle",
        "title": "Change Title"
      },
      {
        "command": "codetourPlus.resetProgress",
        "title": "Reset Progress",
        "category": "CodeTour+"
      },
      {
        "command": "codetourPlus.resetTourProgress",
        "title": "Reset Progress"
      },
      {
        "command": "codetourPlus.deleteTourStep",
        "title": "Delete Step"
      },
      {
        "command": "codetourPlus.deleteTour",
        "title": "Delete Tour"
      },
      {
        "command": "codetourPlus.editTourAtStep",
        "title": "Edit Step"
      },
      {
        "command": "codetourPlus.editTour",
        "title": "Edit Tour",
        "category": "CodeTour+",
        "icon": "$(edit)"
      },
      {
        "command": "codetourPlus.endTour",
        "title": "End Tour",
        "category": "CodeTour+",
        "icon": "$(primitive-square)"
      },
      {
        "command": "codetourPlus.exportTour",
        "title": "Export Tour..."
      },
      {
        "command": "codetourPlus.hideMarkers",
        "title": "Hide Tour Markers",
        "category": "CodeTour+",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codetourPlus.makeTourPrimary",
        "title": "Make Primary"
      },
      {
        "command": "codetourPlus.moveTourStepForward",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codetourPlus.moveTourStepBack",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "codetourPlus.nextTourStep",
        "title": "Next",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codetourPlus.openTourFile",
        "title": "Open Tour File...",
        "icon": "$(folder-opened)",
        "category": "CodeTour+"
      },
      {
        "command": "codetourPlus.openTourUrl",
        "title": "Open Tour URL...",
        "category": "CodeTour+"
      },
      {
        "command": "codetourPlus.previewTour",
        "title": "Preview Tour",
        "icon": "$(preview)"
      },
      {
        "command": "codetourPlus.previousTourStep",
        "title": "Previous",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codetourPlus.recordTour",
        "title": "Record Tour",
        "category": "CodeTour+",
        "icon": "$(add)"
      },
      {
        "command": "codetourPlus.resumeTour",
        "title": "Resume Tour",
        "category": "CodeTour+"
      },
      {
        "command": "codetourPlus.saveTourStep",
        "title": "Save Step",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "codetourPlus.showMarkers",
        "title": "Show Tour Markers",
        "category": "CodeTour+",
        "icon": "$(eye)"
      },
      {
        "command": "codetourPlus.startTour",
        "title": "Start Tour",
        "category": "CodeTour+",
        "icon": "$(play)"
      },
      {
        "command": "codetourPlus.unmakeTourPrimary",
        "title": "Unmake Primary"
      },
      {
        "command": "codetourPlus.viewNotebook",
        "title": "View Notebook",
        "category": "CodeTour+"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codetourPlus.addContentStep",
          "when": "codetourPlus:inTour && codetourPlus:recording && codetourPlus:canEditTour"
        },
        {
          "command": "codetourPlus.endTour",
          "when": "codetourPlus:inTour"
        },
        {
          "command": "codetourPlus.recordTour",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "codetourPlus.resetProgress",
          "when": "codetourPlus:hasProgress"
        },
        {
          "command": "codetourPlus.resumeTour",
          "when": "codetourPlus:inTour"
        },
        {
          "command": "codetourPlus.startTour",
          "when": "codetourPlus:hasTours"
        },
        {
          "command": "codetourPlus.addDirectoryStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.addSelectionStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.addTourStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.changeTourRef",
          "when": "false"
        },
        {
          "command": "codetourPlus.changeTourStepLine",
          "when": "false"
        },
        {
          "command": "codetourPlus.changeTourStepTitle",
          "when": "false"
        },
        {
          "command": "codetourPlus.changeTourStepIcon",
          "when": "false"
        },
        {
          "command": "codetourPlus.changeTourTitle",
          "when": "false"
        },
        {
          "command": "codetourPlus.changeTourDescription",
          "when": "false"
        },
        {
          "command": "codetourPlus.deleteTour",
          "when": "false"
        },
        {
          "command": "codetourPlus.deleteTourStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.editTour",
          "when": "false"
        },
        {
          "command": "codetourPlus.editTourAtStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.exportTour",
          "when": "false"
        },
        {
          "command": "codetourPlus.hideMarkers",
          "when": "false"
        },
        {
          "command": "codetourPlus.makeTourPrimary",
          "when": "false"
        },
        {
          "command": "codetourPlus.nextTourStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.previewTour",
          "when": "false"
        },
        {
          "command": "codetourPlus.previousTourStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.resetTourProgress",
          "when": "false"
        },
        {
          "command": "codetourPlus.saveTourStep",
          "when": "false"
        },
        {
          "command": "codetourPlus.showMarkers",
          "when": "false"
        },
        {
          "command": "codetourPlus.unmakeTourPrimary",
          "when": "false"
        },
        {
          "command": "codetourPlus.viewNotebook",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codetourPlus.previousTourStep",
          "group": "inline@1",
          "when": "commentController == codetourPlus && commentThread =~ /hasPrevious/"
        },
        {
          "command": "codetourPlus.nextTourStep",
          "group": "inline@2",
          "when": "commentController == codetourPlus && commentThread =~ /hasNext/"
        },
        {
          "command": "codetourPlus.endTour",
          "group": "inline@3",
          "when": "commentController == codetourPlus"
        },
        {
          "command": "codetourPlus.editTour",
          "group": "inline@4",
          "when": "commentController == codetourPlus && !codetourPlus:isEditing && codetourPlus:canEditTour"
        },
        {
          "command": "codetourPlus.previewTour",
          "group": "inline@4",
          "when": "commentController == codetourPlus && codetourPlus:isEditing && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codetourPlus.addTourStep",
          "group": "inline",
          "when": "commentController == codetourPlus && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "codetourPlus.moveTourStepBack",
          "group": "move@1",
          "when": "commentController == codetourPlus && codetourPlus:canEditTour && commentThread =~ /hasPrevious/"
        },
        {
          "command": "codetourPlus.moveTourStepForward",
          "group": "move@2",
          "when": "commentController == codetourPlus && codetourPlus:canEditTour && commentThread =~ /hasNext/"
        },
        {
          "command": "codetourPlus.changeTourStepLine",
          "group": "mutate@1",
          "when": "commentController == codetourPlus && codetourPlus:canEditTour"
        },
        {
          "command": "codetourPlus.deleteTourStep",
          "group": "mutate@2",
          "when": "commentController == codetourPlus && codetourPlus:canEditTour"
        }
      ],
      "comments/comment/context": [
        {
          "command": "codetourPlus.saveTourStep",
          "group": "inline@2",
          "when": "commentController == codetourPlus && codetourPlus:recording"
        }
      ],
      "view/title": [
        {
          "command": "codetourPlus.hideMarkers",
          "when": "view == codetourPlus.tours && codetourPlus:showingMarkers",
          "group": "navigation@1"
        },
        {
          "command": "codetourPlus.showMarkers",
          "when": "view == codetourPlus.tours && !codetourPlus:showingMarkers",
          "group": "navigation@1"
        },
        {
          "command": "codetourPlus.openTourFile",
          "when": "view == codetourPlus.tours",
          "group": "navigation@2"
        },
        {
          "command": "codetourPlus.recordTour",
          "when": "view == codetourPlus.tours",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "codetourPlus.endTour",
          "when": "viewItem =~ /^codetourPlus.tour(.recording)?.active/",
          "group": "inline@1"
        },
        {
          "command": "codetourPlus.startTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?$/",
          "group": "inline@1"
        },
        {
          "command": "codetourPlus.resumeTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.recording)?.active$/",
          "group": "active@1"
        },
        {
          "command": "codetourPlus.endTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.recording)?.active$/",
          "group": "active@2"
        },
        {
          "command": "codetourPlus.startTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?$/",
          "group": "basic@1"
        },
        {
          "command": "codetourPlus.viewNotebook",
          "when": "false",
          "group": "basic@2"
        },
        {
          "command": "codetourPlus.addContentStep",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?.recording/",
          "group": "basic@1"
        },
        {
          "command": "codetourPlus.resetTourProgress",
          "when": "false",
          "group": "basic@2"
        },
        {
          "command": "codetourPlus.changeTourTitle",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.recording)?(.active)?$/",
          "group": "change@1"
        },
        {
          "command": "codetourPlus.changeTourDescription",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.recording)?(.active)?$/",
          "group": "change@2"
        },
        {
          "command": "codetourPlus.changeTourRef",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.recording)?(.active)?$/ && gitOpenRepositoryCount != 0",
          "group": "change@3"
        },
        {
          "command": "codetourPlus.makeTourPrimary",
          "when": "viewItem =~ /^codetourPlus.tour(.recording)?(.active)?$/",
          "group": "edit@1"
        },
        {
          "command": "codetourPlus.unmakeTourPrimary",
          "when": "viewItem =~ /^codetourPlus.tour.primary(.recording)?(.active)?$/",
          "group": "edit@2"
        },
        {
          "command": "codetourPlus.editTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.active)?$/",
          "group": "edit@2"
        },
        {
          "command": "codetourPlus.previewTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?.recording/",
          "group": "edit@2"
        },
        {
          "command": "codetourPlus.deleteTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.recording)?(.active)?$/",
          "group": "edit@3"
        },
        {
          "command": "codetourPlus.exportTour",
          "when": "viewItem =~ /^codetourPlus.tour(.primary)?(.active)?$/",
          "group": "export@1"
        },
        {
          "command": "codetourPlus.moveTourStepBack",
          "when": "viewItem =~ /^codetourPlus.tourStep.hasPrevious/",
          "group": "inline@1"
        },
        {
          "command": "codetourPlus.moveTourStepForward",
          "when": "viewItem =~ /codetourPlus.tourStep.*(.hasNext)/",
          "group": "inline@2"
        },
        {
          "command": "codetourPlus.moveTourStepBack",
          "when": "viewItem =~ /^codetourPlus.tourStep.hasPrevious/",
          "group": "basic@1"
        },
        {
          "command": "codetourPlus.moveTourStepForward",
          "when": "viewItem =~ /codetourPlus.tourStep.*(.hasNext)/",
          "group": "basic@2"
        },
        {
          "command": "codetourPlus.changeTourStepTitle",
          "when": "viewItem =~ /^codetourPlus.tourStep/",
          "group": "change@1"
        },
        {
          "command": "codetourPlus.changeTourStepIcon",
          "when": "viewItem =~ /^codetourPlus.tourStep/",
          "group": "change@2"
        },
        {
          "command": "codetourPlus.addContentStep",
          "when": "viewItem =~ /^codetourPlus.tourStep/ && codetourPlus:recording",
          "group": "change@2"
        },
        {
          "command": "codetourPlus.editTourAtStep",
          "when": "viewItem =~ /^codetourPlus.tourStep/ && !codetourPlus:recording",
          "group": "manage@1"
        },
        {
          "command": "codetourPlus.deleteTourStep",
          "when": "viewItem =~ /^codetourPlus.tourStep/",
          "group": "manage@2"
        }
      ],
      "explorer/context": [
        {
          "command": "codetourPlus.addDirectoryStep",
          "when": "codetourPlus:recording && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "codetourPlus.addSelectionStep",
          "when": "codetourPlus:recording && editorHasSelection",
          "group": "codetour@1"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "codetourPlus.tours",
          "name": "CodeTour+",
          "when": "workspaceFolderCount != 0 || codetourPlus:inTour"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codetourPlus.tours",
        "contents": "In order to create a guided walkthrough, you can begin recording a tour for the currently opened workspace ([Learn More](https://github.com/trcoffman/codetour#recording-tours)).\n\n[Record Tour](command:codetourPlus.recordTour)\n\nYou can also open tours that were shared with you by others ([Learn More](https://github.com/trcoffman/codetour#opening-tours)).\n\n[Open Tour File](command:codetourPlus.openTourFile)\n\n[Open Tour URL](command:codetourPlus.openTourUrl)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.tour",
        "url": "./schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "codetourPlus.previousTourStep",
        "when": "codetourPlus:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+left",
        "mac": "cmd+left"
      },
      {
        "command": "codetourPlus.nextTourStep",
        "when": "codetourPlus:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+right",
        "mac": "cmd+right"
      },
      {
        "command": "codetourPlus.endTour",
        "when": "codetourPlus:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+down ctrl+down",
        "mac": "cmd+down cmd+down"
      },
      {
        "command": "codetourPlus.startTour",
        "when": "!textInputFocus && !terminalFocus",
        "key": "ctrl+up ctrl+up",
        "mac": "cmd+up cmd+up"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".tour"
        ]
      }
    ],
    "notebookProvider": [
      {
        "viewType": "codetourPlus",
        "displayName": "CodeTour+",
        "selector": [
          {
            "filenamePattern": "*.tour-notebook"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@types/jexl": "^2.2.0",
    "axios": "^1.21.0",
    "jexl": "^2.3.0",
    "jsonc-parser": "^3.3.1",
    "mobx": "^5.14.2",
    "os-browserify": "0.3.0",
    "path-browserify": "1.0.1",
    "throttle-debounce": "^3.0.1",
    "vsls": "^1.0.2532"
  },
  "devDependencies": {
    "@types/node": "^18.14.0",
    "@types/throttle-debounce": "^5.0.0",
    "@types/vscode": "^1.60",
    "@vscode/vsce": "^4.1.0",
    "debug": "^4.3.4",
    "eslint": "^8.34.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-merge": "^5.8.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  },
  "scripts": {
    "build": "webpack --mode production",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "vscode:prepublish": "npm run build",
    "watch": "webpack --mode development --watch",
    "package": "vsce package"
  },
  "prettier": {
    "arrowParens": "avoid",
    "trailingComma": "none"
  }
}
